<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against MySQL, not in-memory SQLite. StyleDesk's tenant
             isolation leans on real foreign keys, unique indexes and MySQL
             JSON column semantics; SQLite would pass tests that MySQL fails. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="styledesk_v2_testing"/>
        <env name="DB_URL" value=""/>
        <env name="CENTRAL_DOMAINS" value="localhost,127.0.0.1,styledesk.test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- The two idle timeouts, pinned. A developer who has switched them
             off locally is still entitled to a suite that exercises them. -->
        <env name="SESSION_IDLE_TIMEOUT" value="30"/>
        <env name="BACKOFFICE_SESSION_TIMEOUT_MINUTES" value="30"/>
        <!-- The seeder reads this. A blank one locally is a valid choice and
             must not make the suite assert against an admin with no address. -->
        <env name="BACKOFFICE_SUPER_OWNER_EMAIL" value="super-owner@styledesk.test"/>
        <!-- No carrier, ever. Without this the suite inherits real
             credentials from .env, binds the live provider and posts to the
             carrier — which costs money and texts whatever number a fixture
             happens to contain. Tests that mean to exercise the provider
             construct it themselves behind Http::fake(). -->
        <env name="CLICKSEND_USERNAME" value=""/>
        <env name="CLICKSEND_API_KEY" value=""/>
        <env name="CLICKSEND_FROM_NUMBER" value=""/>
        <env name="TELNYX_API_KEY" value=""/>
        <env name="TELNYX_FROM_NUMBER" value=""/>
        <env name="SMS_ALLOW_LIVE_IN_LOCAL" value="false"/>
        <env name="SMS_CATCHER_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
