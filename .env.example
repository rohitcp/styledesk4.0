APP_NAME=StyleDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://styledesk.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
DB_DATABASE=styledesk_v2
DB_USERNAME=root
DB_PASSWORD=root

# --- Multi-tenancy (stancl/tenancy) -------------------------------
# Requests on these hosts are CENTRAL: the marketing site and the
# authenticated app, where the tenant comes from the logged-in user.
# Every other host is treated as a tenant booking subdomain.
CENTRAL_DOMAINS=styledesk.test,www.styledesk.test
TENANT_DOMAIN_SUFFIX=styledesk.test

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_IDLE_TIMEOUT=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.styledesk.test

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailbox
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@styledesk.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Transactional email ------------------------------------------
# Local: `mailbox` captures mail at /mailbox without sending it.
# Production: switch MAIL_MAILER to postmark (or mailgun / letter).
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=outbound

# --- Transactional SMS --------------------------------------------
SENDIVO_API_KEY=
SENDIVO_SENDER_ID=StyleDesk


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="support@styledesk.app"
