APP_NAME=StyleDesk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://styledesk.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
DB_DATABASE=styledesk_v2
DB_USERNAME=root
DB_PASSWORD=root

# --- Multi-tenancy (stancl/tenancy) -------------------------------
# Requests on these hosts are CENTRAL: the marketing site and the
# authenticated app, where the tenant comes from the logged-in user.
# Every other host is treated as a tenant booking subdomain.
CENTRAL_DOMAINS=styledesk.test,www.styledesk.test
TENANT_DOMAIN_SUFFIX=styledesk.test

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_IDLE_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.styledesk.test

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=mailbox
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_AUTH_FROM_ADDRESS="account@styledesk.dev"
MAIL_AUTH_FROM_NAME="StyleDesk"
MAIL_FROM_ADDRESS="noreply@styledesk.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Transactional email ------------------------------------------
# Local: `mailbox` captures mail at /mailbox without sending it.
# Production: switch MAIL_MAILER to postmark (or mailgun / letter).
POSTMARK_API_KEY=
POSTMARK_MESSAGE_STREAM_ID=outbound

# --- Transactional SMS --------------------------------------------
SENDIVO_API_KEY=
SENDIVO_SENDER_ID=StyleDesk


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MAIL_SUPPORT_ADDRESS="support@styledesk.app"

# Where tenant files live. `tenants` is the local directory; `spaces` is
# DigitalOcean Spaces. Nothing above TenantStorageService changes with it.
TENANT_STORAGE_DISK=tenants

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=ams3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_URL=

ACCESS_GATE_CODES=

# The platform console (/backoffice).
# Leave the password empty: the seeder generates one and prints it once.
BACKOFFICE_SUPER_OWNER_EMAIL=
BACKOFFICE_SUPER_OWNER_PASSWORD=
BACKOFFICE_CODE_TTL_MINUTES=10
BACKOFFICE_SESSION_TIMEOUT_MINUTES=30

# Connect Gmail (App Settings → Email).
# One StyleDesk Google Cloud project for the whole platform; each business
# connects its own mailbox through it. Leave blank to keep Gmail switched off —
# the settings card then reads "coming soon" rather than offering a Connect
# button that lands on a Google error page.
# Scopes required: openid, email, https://www.googleapis.com/auth/gmail.send
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/settings/email/gmail/callback"

# Stripe Connect (App Settings -> Payments).
# One StyleDesk platform account; each business connects its own under it, so
# money reaches the salon's bank rather than passing through StyleDesk's.
# Leave blank to keep Stripe switched off — the settings card then reads
# "not available yet" rather than offering a Connect button that fails.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Which processor may charge a card: "stripe", or empty to record only.
BOOKING_CARD_PROVIDER=
